# Required. Used for both Whisper transcription and GPT translation.
OPENAI_API_KEY=

# Folder where finished HTML reports (and shared assets) are written.
OUTPUT_FOLDER=./transcripts

# Must stay whisper-1 - it's the only OpenAI transcription model that
# supports the per-segment timestamps this tool relies on.
WHISPER_TRANSCRIBE_MODEL=whisper-1

# OpenAI chat model used for translation.
OPENAI_MODEL=gpt-4o-mini

# Language code for both the YouTube-captions lookup and Whisper.
SOURCE_LANGUAGE=tr

# A gap of at least this many seconds between spoken segments (or before
# the first / after the last) is marked [[DEMONSTRATION]] in the transcript.
DEMONSTRATION_GAP_SECONDS=7.0

# Whisper's API caps a single upload at 25MB - this is the threshold (with
# headroom) above which a video's audio gets split into ffmpeg-cut parts.
MAX_AUDIO_MB=24

# Browser whose YouTube session cookies yt-dlp borrows to authorize audio
# downloads - YouTube's bot-detection is unreliable without them. Set to
# empty to disable and rely solely on the bgutil PO-token plugin instead.
YT_DLP_COOKIES_BROWSER=chrome

# Path to an exported cookies.txt, tried ahead of YT_DLP_COOKIES_BROWSER.
# Leave empty locally; a deployment needs it, since a server has no
# browser profile to borrow a session from.
YT_DLP_COOKIES_FILE=

# Port used to serve transcripts/ locally after a run so the video embed
# actually works. 0 means "let the OS pick a free port" if this one's taken.
# A hosting platform's $PORT overrides this.
SERVE_PORT=8000


# ---------------------------------------------------------------------
# Hosting only - leave these alone for a local run.
# See the README's "Hosting it for other people" section.
# ---------------------------------------------------------------------

# Interface to bind to. 127.0.0.1 keeps the app private to your own
# machine; a container needs 0.0.0.0 to accept outside traffic.
BIND_HOST=127.0.0.1

# Shared password for the web app. Empty means NO authentication, which is
# fine locally and dangerous anywhere else: without it, anyone who reaches
# the URL can queue jobs billed to your OpenAI key.
APP_PASSWORD=

# Signs the login session cookie. Set a long random value in a deployment
# (`python3 -c "import secrets; print(secrets.token_hex(32))"`) so people
# stay logged in across restarts. Unset = random per process.
SECRET_KEY=

# Set to 1 when serving over HTTPS, so the session cookie is HTTPS-only.
# Must stay off locally or http://127.0.0.1 can never hold a session.
COOKIE_SECURE=

# A base64-encoded cookies.txt, for platforms that only give you env vars
# rather than files. Decoded to YT_COOKIES_PATH (default /tmp/yt-cookies.txt)
# at startup. Set via `fly secrets set`, never committed.
YT_COOKIES_B64=
YT_COOKIES_PATH=
