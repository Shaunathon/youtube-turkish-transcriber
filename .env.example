# Required. Used for both Whisper transcription and GPT translation.
OPENAI_API_KEY=

# Folder where finished HTML reports (and shared assets) are written.
OUTPUT_FOLDER=./transcripts

# Must stay whisper-1 - it's the only OpenAI transcription model that
# supports the per-segment timestamps this tool relies on.
WHISPER_TRANSCRIBE_MODEL=whisper-1

# OpenAI chat model used for translation.
OPENAI_MODEL=gpt-4o-mini

# Language code for both the YouTube-captions lookup and Whisper.
SOURCE_LANGUAGE=tr

# A gap of at least this many seconds between spoken segments (or before
# the first / after the last) is marked [[DEMONSTRATION]] in the transcript.
DEMONSTRATION_GAP_SECONDS=7.0

# Whisper's API caps a single upload at 25MB - this is the threshold (with
# headroom) above which a video's audio gets split into ffmpeg-cut parts.
MAX_AUDIO_MB=24

# Browser whose YouTube session cookies yt-dlp borrows to authorize audio
# downloads - YouTube's bot-detection is unreliable without them. Set to
# empty to disable and rely solely on the bgutil PO-token plugin instead.
YT_DLP_COOKIES_BROWSER=chrome

# Port used to serve transcripts/ locally after a run so the video embed
# actually works. 0 means "let the OS pick a free port" if this one's taken.
SERVE_PORT=8000
